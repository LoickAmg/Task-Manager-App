# Postgres — en local, une base démarrée avec Docker/postgres.app suffit.
# En prod : URL Neon (avec ?sslmode=require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskmanager"

# Secret de session (cookie de connexion). Génère une valeur aléatoire :
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Identifiants du compte seedé au premier démarrage (npm run prisma:seed).
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="changeme123"
SEED_USER_NAME="Admin"

PORT=4000
NODE_ENV=development
